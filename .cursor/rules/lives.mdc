```tsx
// Overlay
<div style={{
  position: "fixed", inset: 0, background: "#00000088",
  display: "flex", alignItems: "center", justifyContent: "center",
  zIndex: 1000, padding: 20,
}}>

// Container
<div style={{
  background: t.cardBg,               // ou brand.blockBg quando adequado
  border: `1px solid ${t.cardBorder}`,
  borderRadius: 20,
