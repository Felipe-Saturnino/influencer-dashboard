SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Header Cookie completo do request /api/ds/query (DevTools, sessão logada no Grafana).
# Renovar quando o script acusar sessão Pomerium expirada.
GRAFANA_GP_KPI_COOKIE=

