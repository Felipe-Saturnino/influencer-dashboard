# Copiar para .env.monitor-cda no servidor Telecom (NÃO commitar).
# Valores reais: canal seguro (1Password / vault), não e-mail em texto claro.

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Mesmo valor configurado em Supabase → Edge Functions → Secrets
MONITOR_LOBBY_CDA_INGEST_SECRET=

# Header Cookie completo (DevTools → casino-categories → Request Headers)
# Renovar quando o job retornar CDA HTTP 401
CDA_LOBBY_COOKIE=

# Opcional — default já embutido no script
# CDA_LOBBY_CATEGORIES_URL=https://casadeapostas.bet.br/api/content/casino-categories?languageId=21
