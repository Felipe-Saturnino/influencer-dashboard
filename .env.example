# Supabase — copie para .env e preencha os valores
# Obtenha em: https://supabase.com/dashboard/project/SEU_PROJETO/settings/api

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional — erros no browser (Sentry). Deixe vazio para desligar.
# VITE_SENTRY_DSN=https://...@...ingest.sentry.io/...

# Só em builds Preview / staging (*.pages.dev): e-mails ou @dominio autorizados a logar.
# Produção e localhost ignoram esta variável. Não afeta /api/* (webhooks).
# VITE_STAGING_LOGIN_ALLOWLIST=felipe.saturnino@spingaming.com.br,@spingaming.com.br
